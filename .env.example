# ==========================================
# MetaCheck AI — Root Environment Variables
# AI-Powered Legal Metrology Compliance & Inspection System
# ==========================================

# Environment Mode: development | staging | production
ENVIRONMENT=development
PROJECT_NAME="MetaCheck AI"
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# Security & Authentication (Phase 7 & 7.1)
# CRITICAL: Replace JWT_SECRET with a cryptographically secure 64+ char random key in production
JWT_SECRET=metacheck_super_secret_jwt_key_replace_with_crypto_random_in_production_2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_ISSUER=metacheck-ai
JWT_AUDIENCE=metacheck-enforcement

# Demo Account Seeding (Set to false in production)
# When true: seeds initial test accounts (Admin@123, Officer@123, Viewer@123) for development/evaluation only.
# When false: no hardcoded accounts are created. Real officers must be registered by Admin.
DEMO_SEED_ENABLED=true

# Database Settings (PostgreSQL AsyncPG)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=metacheck_user
POSTGRES_PASSWORD=metacheck_secure_password_replace_me
POSTGRES_DB=metacheck_db
DATABASE_URL=postgresql+asyncpg://metacheck_user:metacheck_secure_password_replace_me@localhost:5432/metacheck_db

# File Storage & Upload Hardening
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=10
STORAGE_PROVIDER=local

# OCR & Computer Vision Engine
# Options: MOCK | TESSERACT | PADDLEOCR | AUTO
OCR_ENGINE=MOCK

# Backend Network & CORS Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000


