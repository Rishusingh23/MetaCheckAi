# ==========================================
# MetaCheck AI — Backend Configuration
# ==========================================

ENVIRONMENT=development
PROJECT_NAME="MetaCheck AI"
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# Database Connection (PostgreSQL)
# Format: postgresql+asyncpg://user:password@host:port/dbname
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=metacheck_user
POSTGRES_PASSWORD=metacheck_secure_password_replace_me
POSTGRES_DB=metacheck_db
DATABASE_URL=postgresql+asyncpg://metacheck_user:metacheck_secure_password_replace_me@localhost:5432/metacheck_db

# Sync Database URL for Alembic migrations if needed
DATABASE_SYNC_URL=postgresql://metacheck_user:metacheck_secure_password_replace_me@localhost:5432/metacheck_db

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Demo Data Safety & Seeding Configuration
# Production Default: False (Do NOT seed test packages or demo users automatically)
# SIH Demo / Evaluation: Set to true to enable controlled scenario testing
DEMO_DATA_ENABLED=false
DEMO_SEED_ENABLED=false
